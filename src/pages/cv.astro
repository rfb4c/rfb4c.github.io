---
import BaseLayout from '../layouts/BaseLayout.astro';

const PDF = '/cv/Ash_Feng_CV.pdf';

const education = [
  { school: 'Kansai University', where: 'Osaka, Japan', when: '2020–2022', detail: 'M.A. in Sociology (Mass Communication), highest grade in all graded coursework',
    thesis: "Thesis (in Japanese): The Role of the People's Daily WeChat Account in Political Propaganda — With a Focus on Patriotic Propaganda" },
  { school: 'Shanghai Polytechnic University', where: 'Shanghai, China', when: '2014–2018', detail: 'B.A. in English Language and Literature' },
  { school: 'University of Missouri–Kansas City', where: 'Kansas City, MO', when: '2016', detail: 'Exchange Student' },
];

const awards = [
  '2025 · Internal MVP Award, ITXO GenAI Center, Accenture Japan (generative-AI engagement for a major energy utility)',
  '2023 · China News Award (中国新闻奖) — the national journalism award of China (All-China Journalists Association); team award, national infrastructure feature series, The Cover',
];

const skills = [
  { label: 'Research', detail: 'Quantitative content analysis and qualitative close reading; coding scheme development and intercoder reliability.' },
  { label: 'Programming', detail: 'Python, TypeScript, Java, SQL; React, Vue, pandas; Docker, AWS.' },
  { label: 'AI Systems', detail: 'LLM agent development (Strands Agents, MCP); RAG with vector and graph databases; prompt and context engineering; production AI workflow design.' },
];

const certifications = [
  '2026 · Google Cloud Generative AI Leader',
  '2025 · AWS Certified Cloud Practitioner',
  '2019 · Japanese Language Proficiency Test, N1',
  'Chinese (native); English (fluent); Japanese (fluent)',
];
---

<BaseLayout title="CV — Ash Feng" description="Curriculum vitae of Rui (Ash) Feng" noindex={true}>

  <!-- Header -->
  <section class="relative overflow-hidden pt-16 pb-10">
    <div class="absolute top-0 right-0 w-[420px] h-[420px] pointer-events-none select-none" aria-hidden="true">
      <div class="absolute top-4 right-4 w-72 h-72 rounded-full blur-3xl bg-[#7C3AED] opacity-15 dark:opacity-25"></div>
      <div class="absolute top-24 right-16 w-56 h-56 rounded-full blur-3xl bg-[#06B6D4] opacity-15 dark:opacity-20"></div>
    </div>
    <!-- Fade the blobs into the page background so the clipped bottom edge does not read as a rule -->
    <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-white dark:from-[#0A0A0A] pointer-events-none select-none" aria-hidden="true"></div>

    <div class="max-w-2xl mx-auto px-6 relative">
      <div class="flex items-start justify-between gap-6 flex-wrap">
        <div>
          <h1 class="text-xl font-semibold tracking-tight">Rui (Ash) Feng</h1>
          <p class="mt-1 text-sm text-gray-500 dark:text-zinc-400">
            <a href="mailto:ash.rui.feng@gmail.com" class="hover:text-[#7C3AED] dark:hover:text-[#A78BFA] transition-colors">ash.rui.feng@gmail.com</a>
            <span class="text-gray-300 dark:text-zinc-600 px-1.5">·</span>ashfeng.com
            <span class="text-gray-300 dark:text-zinc-600 px-1.5">·</span>Nagoya, Japan
          </p>
        </div>
        <a href={PDF} download
           class="shrink-0 inline-flex items-center gap-2 text-sm font-medium rounded-lg px-4 py-2 bg-[#111111] text-white dark:bg-[#FAFAFA] dark:text-[#0A0A0A] hover:opacity-85 transition-opacity">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"/>
          </svg>
          Download PDF
        </a>
      </div>
    </div>
  </section>

  <div class="max-w-2xl mx-auto px-6">
    <hr class="border-gray-100 dark:border-white/10" />
  </div>

  <!-- Research interests -->
  <section class="py-9">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500 pb-2 mb-4 border-b border-gray-100 dark:border-white/10">Research Interests</h2>
      <p class="text-[15px] text-gray-600 dark:text-zinc-300 leading-relaxed">
        Designing and testing media-system interventions against polarization. Current work
        targets perceived polarization, the misreading of what the other side actually thinks,
        deriving intervention modules from documented mechanisms of out-group misperception and
        implementing them as feed and interface conditions in a platform-independent experimental
        simulator. The next step is controlled online tests of their causal effects; conversational
        AI is a parallel arena for the same logic.
      </p>
    </div>
  </section>

  <!-- Education -->
  <section class="py-9">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500 pb-2 mb-4 border-b border-gray-100 dark:border-white/10">Education</h2>
      <div class="space-y-4">
        {education.map(e => (
          <div>
            <div class="flex items-baseline justify-between gap-4 flex-wrap">
              <span class="text-sm font-medium text-[#111111] dark:text-[#FAFAFA]">{e.school}<span class="font-normal text-gray-400 dark:text-zinc-500"> — {e.where}</span></span>
              <span class="text-xs text-gray-400 dark:text-zinc-500">{e.when}</span>
            </div>
            <p class="text-sm text-gray-500 dark:text-zinc-400 mt-0.5">{e.detail}</p>
            {e.thesis && <p class="text-sm text-gray-500 dark:text-zinc-400 mt-0.5">{e.thesis}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Research experience -->
  <section class="py-9">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500 pb-2 mb-4 border-b border-gray-100 dark:border-white/10">Research Experience</h2>
      <div class="space-y-8">

        <div>
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <span class="text-sm font-medium text-[#111111] dark:text-[#FAFAFA]">Lichtung — Feed-Based Experimental Platform for Perceived Polarization</span>
            <span class="text-xs text-gray-400 dark:text-zinc-500">2026–Present</span>
          </div>
          <p class="text-xs text-gray-500 dark:text-zinc-400 mt-1 italic">
            Independent research project, sole researcher and developer —
            <a href="https://lichtung.ashfeng.com" target="_blank" rel="noopener noreferrer" class="not-italic text-[#7C3AED] dark:text-[#A78BFA] hover:opacity-70 transition-opacity">lichtung.ashfeng.com</a>
            <span class="text-gray-300 dark:text-zinc-600"> · </span>
            <a href="https://github.com/rfb4c/Lichtung" target="_blank" rel="noopener noreferrer" class="not-italic text-[#7C3AED] dark:text-[#A78BFA] hover:opacity-70 transition-opacity">github.com/rfb4c/Lichtung</a>
            <span class="text-gray-300 dark:text-zinc-600"> · </span>
            <a href="https://www.youtube.com/watch?v=ahupkhUs_VI" target="_blank" rel="noopener noreferrer" class="not-italic text-[#7C3AED] dark:text-[#A78BFA] hover:opacity-70 transition-opacity">video walkthrough</a>
          </p>
          <ul class="mt-3 space-y-2">
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span>Designed and built a platform-independent social feed simulator for research on perceived polarization, demonstrating the interventions as interactive feed- and interface-level modules and running without access to commercial-platform APIs, hence without dependence on platform cooperation.</span>
            </li>
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span>Derived three intervention modules from documented mechanisms of out-group misperception and implemented each: reranking that surfaces counter-stereotypical out-party content, a distribution-overlay UI that surfaces the moderate majority obscured by extreme voices, drawing on authoritative poll distributions, and an identity layer that displays shared non-political attributes.</span>
            </li>
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span>Extending it for online experiments, adding randomized condition assignment, behavioral telemetry (exposure sequence, dwell time, scroll depth, interactions), and pre/post survey linkage.</span>
            </li>
          </ul>
        </div>

        <div>
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <span class="text-sm font-medium text-[#111111] dark:text-[#FAFAFA]">R-Selected — Cross-Perspective News Aggregator</span>
            <span class="text-xs text-gray-400 dark:text-zinc-500">2024–2025</span>
          </div>
          <p class="text-xs text-gray-500 dark:text-zinc-400 mt-1 italic">
            Prior independent research project, sole developer — <a href="https://ashfeng.com/research" class="not-italic text-[#7C3AED] dark:text-[#A78BFA] hover:opacity-70 transition-opacity">ashfeng.com/research</a>
          </p>
          <ul class="mt-3 space-y-2">
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span>Built and deployed a news aggregator that collected coverage of the same event from outlets across the political spectrum, premised on the assumption that breaking filter bubbles would reduce polarization.</span>
            </li>
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span>Shut it down after a systematic literature review found the filter-bubble account weakly evidenced (Bruns, 2019; Arguedas et al., 2022) and cross-cutting exposure capable of backfiring (Bail et al., 2018), moving the research target from <em>what users see</em> to <em>how they interpret it</em>; led directly to Lichtung.</span>
            </li>
          </ul>
        </div>

        <div>
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <span class="text-sm font-medium text-[#111111] dark:text-[#FAFAFA]">Constructing the National Community in Times of Crisis: Direction, External Relations, and Internal Representation in People's Daily WeChat Patriotic Propaganda during the COVID-19 Outbreak</span>
            <span class="text-xs text-gray-400 dark:text-zinc-500 shrink-0">Manuscript in preparation, 2026</span>
          </div>
          <p class="text-xs text-gray-500 dark:text-zinc-400 mt-1 italic">Developed from M.A. thesis (Kansai University, 2022).</p>
          <ul class="mt-3 space-y-2">
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span>Hand-coded every headline the <em>People's Daily</em> WeChat account published January–April 2020 (N = 2,318; 761 coded as patriotic propaganda) under an original two-level scheme separating narrative direction (inward vs. outward) from construction mechanism.</span>
            </li>
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span>Construction stayed inward-facing across all four crisis periods (94.1% at peak), and in the outward remainder positive self-positioning and antagonistic othering barely co-occurred (2.5% of 162), splitting the two halves of the standard in-group/out-group script.</span>
            </li>
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span>Horizontal affective solidarity was the largest of five construction mechanisms (48.9% of the patriotic sample) and ran on a reusable heroization template: three formulaic title patterns and three narrative paths, including 28 posts in 16 days sharing one provincial medical-team roster format, with represented figures converging on healthcare workers.</span>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- Journalism -->
  <section class="py-9">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500 pb-2 mb-4 border-b border-gray-100 dark:border-white/10">Journalism</h2>
      <div class="space-y-8">

        <div>
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <span class="text-sm font-medium text-[#111111] dark:text-[#FAFAFA]">The Cover (封面新闻, West China Metropolis Daily Group) — Beijing, China</span>
            <span class="text-xs text-gray-400 dark:text-zinc-500">July–November 2022</span>
          </div>
          <p class="text-xs text-gray-500 dark:text-zinc-400 mt-1 italic">Journalist</p>
          <p class="text-sm text-gray-500 dark:text-zinc-400 mt-2 leading-relaxed">Reported on government, science and technology, and general news.</p>
          <ul class="mt-3 space-y-2">
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span><a href="https://m.thecover.cn/news_details.html?eid=H4rQMrOpoNU=" target="_blank" rel="noopener noreferrer" class="text-[#111111] dark:text-[#FAFAFA] font-medium hover:opacity-70 transition-opacity">Investigation into employment discrimination against people recovering from COVID-19.</a> Prompted a policy response from the Ministry of Human Resources and Social Security.</span>
            </li>
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span><a href="/writing" class="text-[#111111] dark:text-[#FAFAFA] font-medium hover:opacity-70 transition-opacity">National infrastructure feature series.</a> Member of the feature team; the series later received the China News Award.</span>
            </li>
          </ul>
        </div>

        <div>
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <span class="text-sm font-medium text-[#111111] dark:text-[#FAFAFA]">The Paper (澎湃新闻, Shanghai United Media Group) — Shanghai, China</span>
            <span class="text-xs text-gray-400 dark:text-zinc-500">February 2021–January 2022</span>
          </div>
          <p class="text-xs text-gray-500 dark:text-zinc-400 mt-1 italic">Intern Journalist</p>
          <p class="text-sm text-gray-500 dark:text-zinc-400 mt-2 leading-relaxed">Covered cultural affairs in writing, photography, and documentary video.</p>
          <ul class="mt-3 space-y-2">
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span><a href="https://ent.ifeng.com/c/89AtBYbXVBS" target="_blank" rel="noopener noreferrer" class="text-[#111111] dark:text-[#FAFAFA] font-medium hover:opacity-70 transition-opacity">Documentary on Chinese students in Japan during the COVID-19 pandemic.</a> Independently reported, shot, and edited.</span>
            </li>
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span><a href="/writing" class="text-[#111111] dark:text-[#FAFAFA] font-medium hover:opacity-70 transition-opacity">Photography desk and interactive VR dispatches.</a> Profiles of documentary photographers and exhibition criticism; photo essays and VR reports on pandemic-era Shanghai and urban redevelopment.</span>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- Industry Experience -->
  <section class="py-9">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500 pb-2 mb-4 border-b border-gray-100 dark:border-white/10">Industry Experience</h2>
      <div class="space-y-8">

        <div>
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <span class="text-sm font-medium text-[#111111] dark:text-[#FAFAFA]">Accenture Japan — Nagoya, Japan</span>
            <span class="text-xs text-gray-400 dark:text-zinc-500">July 2025–Present</span>
          </div>
          <p class="text-xs text-gray-500 dark:text-zinc-400 mt-1 italic">AI Engineer / Consultant</p>
          <p class="text-sm text-gray-500 dark:text-zinc-400 mt-2 leading-relaxed">
            Joined through the acquisition of Neutral Co., Ltd.
          </p>
          <ul class="mt-3 space-y-2">
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span><span class="text-[#111111] dark:text-[#FAFAFA] font-medium">Retrieval architecture over system documentation and code, major energy utility</span> (August 2026–Present). Proposal team member; running the client requirements sessions and drafting the technical approach: hybrid retrieval across the system's full artifact chain — requirements, design documents, source code — combining a vector store with a knowledge graph of the traceability relations between them.</span>
            </li>
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span><span class="text-[#111111] dark:text-[#FAFAFA] font-medium">Content-generation AI agent for a municipal government's international public relations division</span> (April–June 2026). Developer, then recovery lead; team of 10. Architecture and implementation in Python and Strands Agents: prompt design and generation pipeline.</span>
            </li>
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span><span class="text-[#111111] dark:text-[#FAFAFA] font-medium">AI-driven development workflow for a major energy utility</span> (August 2025–July 2026). Development lead, team of 5. Designed the AI workflow architecture and MCP integration for automated generation of Java error-handling code in a large-scale customer information system.</span>
            </li>
          </ul>
        </div>

        <div>
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <span class="text-sm font-medium text-[#111111] dark:text-[#FAFAFA]">Neutral Co., Ltd. — Nagoya, Japan</span>
            <span class="text-xs text-gray-400 dark:text-zinc-500">July 2023–June 2025</span>
          </div>
          <p class="text-xs text-gray-500 dark:text-zinc-400 mt-1 italic">Software Engineer</p>
          <p class="text-sm text-gray-500 dark:text-zinc-400 mt-2 leading-relaxed">
            Full-stack agile development of a vehicle design support system for a major automotive
            manufacturer: detailed design through implementation, unit test, and system test in Java,
            TypeScript, and Oracle.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Awards -->
  <section class="py-9">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500 pb-2 mb-4 border-b border-gray-100 dark:border-white/10">Awards and Honors</h2>
      <div class="space-y-2">
        {awards.map(a => (
          <p class="text-sm text-gray-500 dark:text-zinc-400 leading-relaxed">{a}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="py-9">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500 pb-2 mb-4 border-b border-gray-100 dark:border-white/10">Skills</h2>
      <div class="space-y-3">
        {skills.map(s => (
          <div class="sm:flex sm:gap-5">
            <span class="block text-sm font-medium text-[#111111] dark:text-[#FAFAFA] sm:w-28 sm:shrink-0">{s.label}</span>
            <span class="block text-sm text-gray-500 dark:text-zinc-400 leading-relaxed mt-0.5 sm:mt-0">{s.detail}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="pt-9 pb-14">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500 pb-2 mb-4 border-b border-gray-100 dark:border-white/10">Certifications and Languages</h2>
      <div class="space-y-2">
        {certifications.map(c => (
          <p class="text-sm text-gray-500 dark:text-zinc-400 leading-relaxed">{c}</p>
        ))}
      </div>

      <div class="mt-10 flex items-center justify-between gap-4 flex-wrap">
        <a href="/" class="text-xs text-gray-400 dark:text-zinc-500 hover:text-[#111111] dark:hover:text-[#FAFAFA] transition-colors">← Back to home</a>
        <a href={PDF} download
           class="inline-flex items-center gap-2 text-sm font-medium rounded-lg px-4 py-2 bg-[#111111] text-white dark:bg-[#FAFAFA] dark:text-[#0A0A0A] hover:opacity-85 transition-opacity">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"/>
          </svg>
          Download PDF
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
