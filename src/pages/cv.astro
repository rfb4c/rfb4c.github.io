---
import BaseLayout from '../layouts/BaseLayout.astro';

const PDF = '/cv/Rui_Feng_CV.pdf';

const education = [
  { school: 'Kansai University', where: 'Osaka, Japan', when: '2018–2022', lines: [
    'M.A. in Sociology (Mass Communication), 2020–2022, highest grade in all graded coursework',
    "Thesis (in Japanese): The Role of the People's Daily WeChat Account in Political Propaganda, with a Focus on Patriotic Propaganda",
    'Foreign Research Student (non-degree), Sociology, 2019–2020',
    'Japanese Language and Culture Program, 2018–2019',
  ] },
  { school: 'Shanghai Polytechnic University', where: 'Shanghai, China', when: '2014–2018', lines: ['Bachelor of Literature in English Language and Literature'] },
  { school: 'University of Missouri–Kansas City', where: 'Kansas City, MO', when: '2016', lines: ['Exchange Student'] },
];

const awards = [
  '2025 · Internal MVP Award, Integrated Operations Center, Accenture Japan',
  "2023 · China Journalism Award (中国新闻奖), China's highest journalism honor; team award, Cover News",
  '2021 · Product of the Year (team series), The Paper',
  '2021 · Yume Sapo (Dream Realization Grant), Kansai University',
  '2021 · Kansai University Grant Scholarship',
  '2020 · Monbukagakusho Honors Scholarship for Privately-Financed International Students (Japanese Ministry of Education)',
  '2020 · Kansai University Scholarship for Japanese Language and Culture Program Graduates',
  '2015 · Second-Class University Scholarship, Shanghai Polytechnic University (2014–2015 academic year)',
  '2014 · Outstanding Student Reporter, Official Weibo Team, Shanghai Polytechnic University',
];

const exhibitions = [
  'Video curation, “Shanghai Expressions at the Turn of the Century” (世纪之交的上海表情), solo photography exhibition by Xu Haifeng, Yuanse Art Space, M50, Shanghai, 2022.',
  'Documentary (sole filmmaker), “2020, the Diary of Overseas Chinese Students under the Pandemic,” ImaginAsia 2021 online exhibition, National Chengchi University, 2021.',
];

const skills = [
  { label: 'Research', detail: "Quantitative content analysis and qualitative close reading; codebook development, full-population census design, and intercoder reliability (Cohen's κ)." },
  { label: 'Programming', detail: 'Python, TypeScript, Java, SQL; React, PostgreSQL, pandas; Docker, AWS, Azure.' },
  { label: 'AI Systems', detail: 'LLM agent development (Strands Agents, MCP); RAG with vector and graph databases; prompt and context engineering; production AI workflow design.' },
  { label: 'Certifications', detail: 'Google Cloud Generative AI Leader (2026); AWS Certified Cloud Practitioner (2025).' },
  { label: 'Languages', detail: 'Chinese (native); English (fluent); Japanese (fluent; JLPT N1, 2019).' },
];
---

<BaseLayout title="CV — Ash Feng" description="Curriculum vitae of Rui (Ash) Feng" noindex={true}>

  <!-- Header -->
  <section class="relative overflow-hidden pt-16 pb-10">
    <div class="absolute top-0 right-0 w-[420px] h-[420px] pointer-events-none select-none" aria-hidden="true">
      <div class="absolute top-4 right-4 w-72 h-72 rounded-full blur-3xl bg-[#7C3AED] opacity-15 dark:opacity-25"></div>
      <div class="absolute top-24 right-16 w-56 h-56 rounded-full blur-3xl bg-[#06B6D4] opacity-15 dark:opacity-20"></div>
    </div>
    <!-- Fade the blobs into the page background so the clipped bottom edge does not read as a rule -->
    <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-white dark:from-[#0A0A0A] pointer-events-none select-none" aria-hidden="true"></div>

    <div class="max-w-2xl mx-auto px-6 relative">
      <div class="flex items-start justify-between gap-6 flex-wrap">
        <div>
          <h1 class="text-xl font-semibold tracking-tight">Rui (Ash) Feng</h1>
          <p class="mt-1 text-sm text-gray-500 dark:text-zinc-400">
            <a href="mailto:ash.rui.feng@gmail.com" class="hover:text-[#7C3AED] dark:hover:text-[#A78BFA] transition-colors">ash.rui.feng@gmail.com</a>
            <span class="text-gray-300 dark:text-zinc-600 px-1.5">·</span>ashfeng.com
            <span class="text-gray-300 dark:text-zinc-600 px-1.5">·</span>Nagoya, Japan
          </p>
        </div>
        <a href={PDF} download
           class="shrink-0 inline-flex items-center gap-2 text-sm font-medium rounded-lg px-4 py-2 bg-[#111111] text-white dark:bg-[#FAFAFA] dark:text-[#0A0A0A] hover:opacity-85 transition-opacity">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"/>
          </svg>
          Download PDF
        </a>
      </div>
    </div>
  </section>

  <div class="max-w-2xl mx-auto px-6">
    <hr class="border-gray-100 dark:border-white/10" />
  </div>

  <!-- Research interests -->
  <section class="py-9">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500 pb-2 mb-4 border-b border-gray-100 dark:border-white/10">Research Interests</h2>
      <p class="text-[15px] text-gray-600 dark:text-zinc-300 leading-relaxed">
        Designing and testing media-system interventions against polarization. Current work
        targets perceived polarization, the systematic misperception of what each political side
        believes and how hostile it is, through feed and interface interventions derived from
        potential mechanisms of out-group misperception. The next step is controlled experiments
        testing their causal effects; conversational AI is a parallel arena for the same logic.
      </p>
    </div>
  </section>

  <!-- Education -->
  <section class="py-9">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500 pb-2 mb-4 border-b border-gray-100 dark:border-white/10">Education</h2>
      <div class="space-y-4">
        {education.map(e => (
          <div>
            <div class="flex items-baseline justify-between gap-4 flex-wrap">
              <span class="text-sm font-medium text-[#111111] dark:text-[#FAFAFA]">{e.school}<span class="font-normal text-gray-400 dark:text-zinc-500">, {e.where}</span></span>
              <span class="text-xs text-gray-400 dark:text-zinc-500">{e.when}</span>
            </div>
            {e.lines.map(l => (
              <p class="text-sm text-gray-500 dark:text-zinc-400 mt-0.5">{l}</p>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Manuscripts -->
  <section class="py-9">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500 pb-2 mb-4 border-b border-gray-100 dark:border-white/10">Manuscripts</h2>
      <div class="space-y-3">
        <p class="text-sm text-gray-500 dark:text-zinc-400 leading-relaxed">
          Feng, R. <span class="text-[#111111] dark:text-[#FAFAFA]">Lichtung: Turning Perceived-Polarization Mechanisms into Three Auditable Feed Interventions.</span>
          Under review at the Posters &amp; Demos track, 32nd ACM Conference on Intelligent User Interfaces (IUI ’27).
        </p>
        <p class="text-sm text-gray-500 dark:text-zinc-400 leading-relaxed">
          Feng, R. <span class="text-[#111111] dark:text-[#FAFAFA]">Constructing the National Community in Times of Crisis: Direction, External Relations, and Internal Representation in <em>People's Daily</em> WeChat Patriotic Propaganda during the COVID-19 Outbreak.</span>
          <em>Working paper, 2026.</em>
        </p>
      </div>
    </div>
  </section>

  <!-- Research experience -->
  <section class="py-9">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500 pb-2 mb-4 border-b border-gray-100 dark:border-white/10">Research Experience</h2>
      <div class="space-y-8">

        <div>
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <span class="text-sm font-medium text-[#111111] dark:text-[#FAFAFA]">Lichtung (Feed-Based Experimental Platform for Perceived Polarization)</span>
            <span class="text-xs text-gray-400 dark:text-zinc-500">2026–Present</span>
          </div>
          <p class="text-xs text-gray-500 dark:text-zinc-400 mt-1 italic">
            Independent research project, sole researcher and developer —
            <a href="https://lichtung.ashfeng.com" target="_blank" rel="noopener noreferrer" class="not-italic text-[#7C3AED] dark:text-[#A78BFA] hover:opacity-70 transition-opacity">lichtung.ashfeng.com</a>
            <span class="text-gray-300 dark:text-zinc-600"> · </span>
            <a href="https://github.com/rfb4c/Lichtung" target="_blank" rel="noopener noreferrer" class="not-italic text-[#7C3AED] dark:text-[#A78BFA] hover:opacity-70 transition-opacity">github.com/rfb4c/Lichtung</a>
            <span class="text-gray-300 dark:text-zinc-600"> · </span>
            <a href="https://www.youtube.com/watch?v=ahupkhUs_VI" target="_blank" rel="noopener noreferrer" class="not-italic text-[#7C3AED] dark:text-[#A78BFA] hover:opacity-70 transition-opacity">video walkthrough</a>
          </p>
          <ul class="mt-3 space-y-2">
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span>Designed and built a platform-independent social feed simulator for perceived-polarization research, running the interventions as feed- and interface-level modules without commercial-platform APIs or cooperation.</span>
            </li>
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span>Derived three intervention modules from potential mechanisms of out-group misperception and implemented each: reranking that surfaces counter-stereotypical out-party content, a distribution-overlay UI that surfaces the moderate majority obscured by extreme voices, drawing on authoritative poll distributions, and an identity layer that displays non-political attributes.</span>
            </li>
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span>Built the offline LLM annotation pipeline behind the interventions: two judges from different model vendors score each item against criteria frozen before the run and merge under a fixed rule, with raw verdicts and inter-judge agreement inspectable in the interface.</span>
            </li>
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span>Extending it for online experiments with random assignment, behavioral logging, and pre/post surveys.</span>
            </li>
          </ul>
        </div>

        <div>
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <span class="text-sm font-medium text-[#111111] dark:text-[#FAFAFA]">R-Selected (Cross-Perspective News Aggregator)</span>
            <span class="text-xs text-gray-400 dark:text-zinc-500">2024–2025</span>
          </div>
          <p class="text-xs text-gray-500 dark:text-zinc-400 mt-1 italic">
            Prior independent research project, sole developer — <a href="https://ashfeng.com/research" class="not-italic text-[#7C3AED] dark:text-[#A78BFA] hover:opacity-70 transition-opacity">ashfeng.com/research</a>
          </p>
          <ul class="mt-3 space-y-2">
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span>Built and deployed a news aggregator collecting coverage of the same event across the political spectrum; shut it down once the research literature undercut its filter-bubble premise, leading directly to Lichtung.</span>
            </li>
          </ul>
        </div>

        <div>
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <span class="text-sm font-medium text-[#111111] dark:text-[#FAFAFA]">Constructing the National Community in Times of Crisis</span>
            <span class="text-xs text-gray-400 dark:text-zinc-500">2026</span>
          </div>
          <p class="text-xs text-gray-500 dark:text-zinc-400 mt-1 italic">Sole author; takes up a question the M.A. thesis left open, under a newly built codebook.</p>
          <ul class="mt-3 space-y-2">
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span>Hand-coded every headline the <em>People's Daily</em> WeChat account published January–April 2020 (N = 2,318; 761 coded as patriotic propaganda) under an original two-level scheme separating narrative direction (inward vs. outward) from construction mechanism.</span>
            </li>
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span>A second coder independently recoded a 235-item subsample held out from codebook calibration, giving Cohen's κ = .74–.91 across seven variables; an audit of 112 posts excluded by the screening filter found 1 that met the inclusion criteria.</span>
            </li>
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span>Construction of the national community stayed inward-facing across all four crisis periods, splitting the standard in-group/out-group script: positive self-positioning and antagonistic othering rarely co-occurred. The dominant mechanism was horizontal affective solidarity, running on a reusable heroization template of formulaic title patterns and narrative paths.</span>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- Journalism -->
  <section class="py-9">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500 pb-2 mb-4 border-b border-gray-100 dark:border-white/10">Journalism</h2>
      <div class="space-y-8">

        <div>
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <span class="text-sm font-medium text-[#111111] dark:text-[#FAFAFA]">Cover News (封面新闻)<span class="font-normal text-gray-400 dark:text-zinc-500">, Beijing, China</span></span>
            <span class="text-xs text-gray-400 dark:text-zinc-500">July–November 2022</span>
          </div>
          <p class="text-xs text-gray-500 dark:text-zinc-400 mt-1 italic">Journalist</p>
          <p class="text-sm text-gray-500 dark:text-zinc-400 mt-2 leading-relaxed">Reported on government, science and technology, and general news.</p>
          <ul class="mt-3 space-y-2">
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span><a href="https://m.thecover.cn/news_details.html?eid=H4rQMrOpoNU=" target="_blank" rel="noopener noreferrer" class="text-[#111111] dark:text-[#FAFAFA] font-medium hover:opacity-70 transition-opacity">Investigation into employment discrimination against people who had recovered from COVID-19.</a> Prompted a policy response from the Ministry of Human Resources and Social Security.</span>
            </li>
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span><a href="/writing" class="text-[#111111] dark:text-[#FAFAFA] font-medium hover:opacity-70 transition-opacity">National infrastructure feature series.</a> Feature team member; the series won the China Journalism Award.</span>
            </li>
          </ul>
        </div>

        <div>
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <span class="text-sm font-medium text-[#111111] dark:text-[#FAFAFA]">The Paper (澎湃新闻)<span class="font-normal text-gray-400 dark:text-zinc-500">, Shanghai, China</span></span>
            <span class="text-xs text-gray-400 dark:text-zinc-500">February 2021–January 2022</span>
          </div>
          <p class="text-xs text-gray-500 dark:text-zinc-400 mt-1 italic">Intern Journalist</p>
          <p class="text-sm text-gray-500 dark:text-zinc-400 mt-2 leading-relaxed">Covered cultural affairs in writing, photography, and documentary video.</p>
          <ul class="mt-3 space-y-2">
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span><a href="https://ent.ifeng.com/c/89AtBYbXVBS" target="_blank" rel="noopener noreferrer" class="text-[#111111] dark:text-[#FAFAFA] font-medium hover:opacity-70 transition-opacity">Documentary on Chinese students in Japan during COVID-19.</a> Independently reported, shot, and edited.</span>
            </li>
            <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
              <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
              <span><a href="/writing" class="text-[#111111] dark:text-[#FAFAFA] font-medium hover:opacity-70 transition-opacity">Photography desk and VR dispatches.</a> Photographer profiles, exhibition reviews, photo essays, VR reports.</span>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- Industry Experience -->
  <section class="py-9">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500 pb-2 mb-4 border-b border-gray-100 dark:border-white/10">Industry Experience</h2>
      <div class="space-y-8">

        <div>
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <span class="text-sm font-medium text-[#111111] dark:text-[#FAFAFA]">Accenture Japan<span class="font-normal text-gray-400 dark:text-zinc-500"> (via acquisition of Neutral Co., Ltd., July 2025), Nagoya, Japan</span></span>
            <span class="text-xs text-gray-400 dark:text-zinc-500">2023–Present</span>
          </div>

          <div class="mt-3 ml-4">
            <div class="flex items-baseline justify-between gap-4 flex-wrap">
              <span class="text-xs text-gray-500 dark:text-zinc-400 italic">AI Engineer / Consultant</span>
              <span class="text-xs text-gray-400 dark:text-zinc-500">July 2025–Present</span>
            </div>
            <ul class="mt-2 space-y-2">
              <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
                <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
                <span><span class="text-[#111111] dark:text-[#FAFAFA] font-medium">RAG solution, major energy utility</span> (August 2026–Present). Proposal team member; now leading an offshore development team, handling client requirements, and developing part of the system.</span>
              </li>
              <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
                <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
                <span><span class="text-[#111111] dark:text-[#FAFAFA] font-medium">Content-generation AI agent for a municipal government's international PR division</span> (April–June 2026). Developer, then recovery lead; team of 10. Designed and built the prompts and generation pipeline.</span>
              </li>
              <li class="flex gap-3 text-sm leading-relaxed text-gray-500 dark:text-zinc-400">
                <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
                <span><span class="text-[#111111] dark:text-[#FAFAFA] font-medium">AI-driven development workflow, major energy utility</span> (August 2025–July 2026). Development lead, team of 5. Designed the workflow architecture and MCP integration for generating Java error-handling code.</span>
              </li>
            </ul>
          </div>

          <div class="mt-4 ml-4">
            <div class="flex items-baseline justify-between gap-4 flex-wrap">
              <span class="text-xs text-gray-500 dark:text-zinc-400 italic">Software Engineer, Neutral Co., Ltd.</span>
              <span class="text-xs text-gray-400 dark:text-zinc-500">2023–July 2025</span>
            </div>
            <p class="text-sm text-gray-500 dark:text-zinc-400 mt-2 leading-relaxed">
              Full-stack development of a vehicle design support system for a major automaker (Java,
              TypeScript, Oracle).
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Awards -->
  <section class="py-9">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500 pb-2 mb-4 border-b border-gray-100 dark:border-white/10">Awards and Honors</h2>
      <div class="space-y-2">
        {awards.map(a => (
          <p class="text-sm text-gray-500 dark:text-zinc-400 leading-relaxed">{a}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- Exhibitions -->
  <section class="py-9">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500 pb-2 mb-4 border-b border-gray-100 dark:border-white/10">Exhibitions</h2>
      <div class="space-y-2">
        {exhibitions.map(x => (
          <p class="text-sm text-gray-500 dark:text-zinc-400 leading-relaxed">{x}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- Skills, certifications, and languages -->
  <section class="pt-9 pb-14">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500 pb-2 mb-4 border-b border-gray-100 dark:border-white/10">Skills, Certifications, and Languages</h2>
      <div class="space-y-3">
        {skills.map(s => (
          <div class="sm:flex sm:gap-5">
            <span class="block text-sm font-medium text-[#111111] dark:text-[#FAFAFA] sm:w-28 sm:shrink-0">{s.label}</span>
            <span class="block text-sm text-gray-500 dark:text-zinc-400 leading-relaxed mt-0.5 sm:mt-0">{s.detail}</span>
          </div>
        ))}
      </div>

      <div class="mt-10 flex items-center justify-between gap-4 flex-wrap">
        <a href="/" class="text-xs text-gray-400 dark:text-zinc-500 hover:text-[#111111] dark:hover:text-[#FAFAFA] transition-colors">← Back to home</a>
        <a href={PDF} download
           class="inline-flex items-center gap-2 text-sm font-medium rounded-lg px-4 py-2 bg-[#111111] text-white dark:bg-[#FAFAFA] dark:text-[#0A0A0A] hover:opacity-85 transition-opacity">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"/>
          </svg>
          Download PDF
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
