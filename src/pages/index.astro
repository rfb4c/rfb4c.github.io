---
import BaseLayout from '../layouts/BaseLayout.astro';
import { featuredWorks } from '../data/writing';

const investigation = featuredWorks.find(w => w.type === 'Investigation')!;
const documentary = featuredWorks.find(w => w.type === 'Documentary')!;
const photography = featuredWorks.find(w => w.type === 'Photography')!;

const modules = [
  {
    name: 'Exemplar diversity',
    detail: 'surfacing counter-stereotypical voices within each side, implemented through ranking',
  },
  {
    name: 'Distribution overlay',
    detail: 'revealing that moderate views form the majority within each camp, through interface cues',
  },
  {
    name: 'Identity salience',
    detail: 'restoring multidimensional identity cues by reducing partisan-label prominence and surfacing shared identities',
  },
];
---

<BaseLayout title="Ash Feng">

  <!-- Hero -->
  <section class="relative overflow-hidden pt-16 pb-12">
    <!-- Diffuse light blobs -->
    <div class="absolute top-0 right-0 w-[480px] h-[480px] pointer-events-none select-none" aria-hidden="true">
      <div class="absolute top-4 right-4 w-80 h-80 rounded-full blur-3xl bg-[#7C3AED] opacity-20 dark:opacity-30"></div>
      <div class="absolute top-24 right-16 w-64 h-64 rounded-full blur-3xl bg-[#F97316] opacity-20 dark:opacity-30"></div>
      <div class="absolute top-8 right-52 w-48 h-48 rounded-full blur-3xl bg-[#06B6D4] opacity-15 dark:opacity-20"></div>
    </div>
    <!-- Fade the blobs into the page background so the clipped bottom edge does not read as a rule -->
    <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-white dark:from-[#0A0A0A] pointer-events-none select-none" aria-hidden="true"></div>

    <div class="max-w-2xl mx-auto px-6 relative">
      <!-- Profile row -->
      <div class="mb-8">
        <h1 class="text-xl font-semibold tracking-tight">Ash Feng</h1>
        <p class="mt-0.5 text-sm text-gray-500 dark:text-zinc-400">AI Engineer · Former Journalist in China</p>
        <p class="text-xs text-gray-400 dark:text-zinc-500 mt-0.5">Nagoya, Japan</p>
      </div>

      <p class="text-sm text-gray-500 dark:text-zinc-400 mb-5">Designing media environments for mutual understanding.</p>

      <!-- Research interest tags -->
      <div class="flex flex-wrap gap-2">
        {['Social Computing', 'Perceived Polarization', 'Perception-Targeted Intervention Design'].map(tag => (
          <span class="text-xs px-3 py-1 rounded-full border border-gray-200 dark:border-white/15 text-gray-500 dark:text-zinc-400">
            {tag}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="pt-6 sm:pt-0 pb-14">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500 mb-5">About</h2>
      <div class="space-y-4 text-[15px] text-gray-600 dark:text-zinc-300 leading-relaxed">
        <p>
          When a reporting series I helped produce received the China News Award — the
          profession's highest honor in China — I found myself unable to celebrate. I had entered
          journalism believing that better content could change how people understood one another.
          But I came to see a structural limit: content matters only within the systems that
          distribute and amplify it.
        </p>
        <p>
          <span class="text-[#111111] dark:text-[#FAFAFA]">I entered journalism to change what
          people read; I left it to change how they encounter information.</span> So I moved
          upstream. I taught myself to program and became an engineer, shifting from producing
          content to building the systems that mediate it. Today I build content-generation AI
          agents as an engineer in Japan.
        </p>
        <p>
          Engineering taught me how to build interventions, but not how to know whether they work.
          That requires controlled experiments and causal inference — the training I now seek
          through a PhD beginning in Fall 2027.
        </p>
      </div>
      <div class="mt-5 flex justify-end">
        <a href="/cv" class="text-xs text-[#7C3AED] dark:text-[#A78BFA] hover:opacity-70 transition-opacity">Full CV →</a>
      </div>
    </div>
  </section>

  <div class="max-w-2xl mx-auto px-6">
    <hr class="border-gray-100 dark:border-white/10" />
  </div>

  <!-- Current research -->
  <section id="research" class="py-14 scroll-mt-20">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500 mb-5">Current Research</h2>

      <h3 class="text-base font-semibold text-[#111111] dark:text-[#FAFAFA] leading-snug">
        Turning mechanisms of misperception into system design
      </h3>
      <div class="space-y-4 text-[15px] text-gray-600 dark:text-zinc-300 leading-relaxed mt-2">
        <p>
          People systematically overestimate how extreme and hostile the other side is — a
          phenomenon known as
          <span class="text-[#111111] dark:text-[#FAFAFA] font-medium">perceived polarization</span>.
          I focus on how media environments shape the cues people use to infer what others believe.
        </p>
        <p>
          My work follows a
          <span class="text-[#111111] dark:text-[#FAFAFA] font-medium">mechanism-to-design</span>
          approach. I start with documented mechanisms that distort social inference, translate each
          into a
          <span class="text-[#111111] dark:text-[#FAFAFA] font-medium">platform-agnostic intervention function</span>,
          and then instantiate that function through the affordances of a particular system. This
          separates the principle of an intervention from any one interface or platform — and makes
          it possible to ask whether the same principle generalizes across interaction forms.
        </p>
        <p>
          The goal is not to change what people believe, but
          <span class="text-[#111111] dark:text-[#FAFAFA] font-medium">how accurately they perceive one another</span>.
        </p>
      </div>

      <!-- Two test arenas -->
      <p class="mt-8 text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500 mb-3">Two test arenas</p>
      <div class="space-y-3">
        <div class="flex gap-3">
          <span class="w-1.5 h-1.5 mt-[7px] rounded-full bg-[#2EA875] shrink-0"></span>
          <p class="text-sm text-gray-500 dark:text-zinc-400 leading-relaxed">
            <span class="text-[#111111] dark:text-[#FAFAFA] font-medium">Algorithmic feeds</span>
            <span class="text-gray-300 dark:text-zinc-600"> · </span>the first experimental setting,
            where these intervention functions can be instantiated as ranking and interface
            manipulations and causally tested.
          </p>
        </div>
        <div class="flex gap-3">
          <span class="w-1.5 h-1.5 mt-[7px] rounded-full border border-gray-400 dark:border-zinc-500 shrink-0"></span>
          <p class="text-sm text-gray-500 dark:text-zinc-400 leading-relaxed">
            <span class="text-[#111111] dark:text-[#FAFAFA] font-medium">Conversational AI</span>
            <span class="text-gray-300 dark:text-zinc-600"> · </span>a second arena for testing
            whether the same underlying functions can be realized — and remain effective — in a
            different interaction architecture.
          </p>
        </div>
      </div>

      <!-- Status statement -->
      <blockquote class="mt-7 pl-4 border-l-2 border-[#7C3AED]/40 dark:border-[#A78BFA]/40">
        <p class="text-[15px] text-gray-600 dark:text-zinc-300 leading-relaxed">
          I built Lichtung to make these interventions experimentally testable. In my PhD, my next
          step is twofold: to test their causal effects in feed environments, and to translate the
          underlying intervention functions into conversational AI as a second test arena.
        </p>
      </blockquote>

      <!-- The testbed -->
      <p class="mt-10 text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500 mb-3">Experimental testbed</p>

      <div class="flex items-baseline gap-2.5 flex-wrap">
        <span class="text-base font-semibold text-[#111111] dark:text-[#FAFAFA]">Lichtung</span>
        <span class="text-sm text-gray-400 dark:text-zinc-500">林间空地</span>
      </div>
      <p class="text-[15px] text-gray-600 dark:text-zinc-300 leading-relaxed mt-1.5">
        A platform-independent social-feed simulator I built to turn these intervention designs
        into experimentally manipulable conditions, without relying on commercial-platform APIs.
        Three modules are currently implemented:
      </p>

      <ul class="mt-4 space-y-2">
        {modules.map(m => (
          <li class="flex gap-3 text-sm leading-relaxed">
            <span class="text-gray-300 dark:text-zinc-600 select-none">—</span>
            <span class="text-gray-500 dark:text-zinc-400">
              <span class="text-[#111111] dark:text-[#FAFAFA] font-medium">{m.name}</span>
              <span class="text-gray-300 dark:text-zinc-600"> · </span>{m.detail}
            </span>
          </li>
        ))}
      </ul>

      <!-- Live system card -->
      <div class="mt-6 rounded-xl border border-gray-200 dark:border-white/10 overflow-hidden">
        <div class="grid sm:grid-cols-[1.25fr_1fr]">

          <!-- Live preview, inset in its own panel -->
          <div class="bg-gray-50 dark:bg-white/[0.03] p-4 sm:p-5 flex items-center">
            <a href="https://lichtung.ashfeng.com" target="_blank" rel="noopener noreferrer"
               class="group block w-full rounded-lg overflow-hidden border border-gray-200/80 dark:border-white/10 shadow-sm">
              <img src="/images/lichtung-preview.webp" alt="The Lichtung feed simulator running"
                   class="w-full aspect-[16/11] object-cover object-left-top group-hover:scale-[1.04] transition-transform duration-700" />
            </a>
          </div>

          <!-- Metadata -->
          <div class="p-5 flex flex-col gap-5 bg-white dark:bg-transparent border-t sm:border-t-0 sm:border-l border-gray-200 dark:border-white/10">

            <div>
              <p class="text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500">Live system</p>
              <a href="https://lichtung.ashfeng.com" target="_blank" rel="noopener noreferrer"
                 class="mt-1 inline-flex items-center gap-1 text-sm font-medium text-[#111111] dark:text-[#FAFAFA] hover:text-[#7C3AED] dark:hover:text-[#A78BFA] transition-colors">
                lichtung.ashfeng.com
                <svg class="w-3 h-3 opacity-40" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </a>
              <p class="text-xs text-gray-400 dark:text-zinc-500 mt-1">No signup — the feed loads running.</p>
            </div>

            <div>
              <p class="text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500 mb-2">Status</p>
              <div class="space-y-1.5">
                <div class="flex items-baseline gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#2EA875] shrink-0 translate-y-[-1px]"></span>
                  <span class="text-sm text-[#111111] dark:text-[#FAFAFA]">Built</span>
                  <span class="text-xs text-gray-400 dark:text-zinc-500">three intervention modules</span>
                </div>
                <div class="flex items-baseline gap-2">
                  <span class="w-1.5 h-1.5 rounded-full border border-gray-400 dark:border-zinc-500 shrink-0 translate-y-[-1px]"></span>
                  <span class="text-sm text-gray-500 dark:text-zinc-400">Proposed</span>
                  <span class="text-xs text-gray-400 dark:text-zinc-500">causal testing, in my PhD</span>
                </div>
              </div>
            </div>

            <div class="mt-auto">
              <a href="https://lichtung.ashfeng.com" target="_blank" rel="noopener noreferrer"
                 class="block w-full text-center text-sm font-medium rounded-lg px-4 py-2 bg-[#111111] text-white dark:bg-[#FAFAFA] dark:text-[#0A0A0A] hover:opacity-85 transition-opacity">
                Open the live demo →
              </a>
              <div class="mt-2.5 flex items-center justify-center gap-3 text-xs">
                <a href="/demo" class="text-gray-500 dark:text-zinc-400 hover:text-[#7C3AED] dark:hover:text-[#A78BFA] transition-colors">Walkthrough</a>
                <span class="text-gray-200 dark:text-white/10">|</span>
                <a href="https://github.com/rfb4c/Lichtung" target="_blank" rel="noopener noreferrer" class="text-gray-500 dark:text-zinc-400 hover:text-[#7C3AED] dark:hover:text-[#A78BFA] transition-colors">GitHub</a>
              </div>
            </div>

          </div>
        </div>
      </div>

      <p class="mt-3 text-xs text-gray-400 dark:text-zinc-500">React · TypeScript</p>
    </div>
  </section>

  <div class="max-w-2xl mx-auto px-6">
    <hr class="border-gray-100 dark:border-white/10" />
  </div>

  <!-- How I got here -->
  <section class="py-14">
    <div class="max-w-2xl mx-auto px-6">
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500">How I got here</h2>
        <a href="/research" class="text-xs text-[#7C3AED] dark:text-[#A78BFA] hover:opacity-70 transition-opacity">Full research narrative →</a>
      </div>
      <p class="text-[15px] text-gray-600 dark:text-zinc-300 leading-relaxed">
        My M.A. research examined how party-press social media constructed collective sentiment
        during the early pandemic; later, I built R-Selected, a news aggregator that placed
        coverage of the same event from different political perspectives side by side, based on
        the intuition that broader exposure might reduce polarization. A literature review made me abandon that premise:
        evidence for filter bubbles was weaker than I had assumed, and cross-cutting exposure
        could even backfire. That failure redirected my research from
        <span class="text-[#111111] dark:text-[#FAFAFA] font-medium">what people see</span> to
        <span class="text-[#111111] dark:text-[#FAFAFA] font-medium">how they interpret what they see</span>.
      </p>
    </div>
  </section>

  <div class="max-w-2xl mx-auto px-6">
    <hr class="border-gray-100 dark:border-white/10" />
  </div>

  <!-- Journalism -->
  <section class="py-14">
    <div class="max-w-2xl mx-auto px-6">
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-[10px] font-semibold uppercase tracking-[0.15em] text-gray-400 dark:text-zinc-500">Journalism</h2>
        <a href="/writing" class="text-xs text-[#7C3AED] dark:text-[#A78BFA] hover:opacity-70 transition-opacity">All work →</a>
      </div>

      <div class="space-y-3">

        <!-- Investigation — top, most prominent, image + strong overlay -->
        <a href={investigation.url} target="_blank" rel="noopener noreferrer"
           class="group relative block rounded-xl overflow-hidden aspect-[2/1]">
          <img src={investigation.image} alt={investigation.title}
               class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"></div>
          <div class="absolute inset-0 p-5 flex flex-col justify-between">
            <span class="text-[10px] font-semibold uppercase tracking-[0.12em] text-white/50">{investigation.type} · {investigation.publication} · {investigation.year}</span>
            <div>
              <h3 class="text-base font-semibold text-white leading-snug mb-2">{investigation.title}</h3>
              <p class="text-xs text-white/60 leading-relaxed line-clamp-2 max-w-[60%]">{investigation.description}</p>
              {investigation.note && <p class="mt-2 text-[10px] text-[#FB923C]">{investigation.note}</p>}
            </div>
          </div>
        </a>

        <!-- Photography — middle, wide landscape crop -->
        <a href={photography.url} target="_blank" rel="noopener noreferrer"
           class="group relative block rounded-xl overflow-hidden aspect-[16/9]">
          <img src={photography.image} alt={photography.title}
               class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-4">
            <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-white/50">{photography.type} · {photography.publication} · {photography.year}</p>
            <h3 class="mt-1 text-sm font-semibold text-white leading-snug">{photography.title}</h3>
          </div>
        </a>

        <!-- Documentary — bottom, cinematic letterbox -->
        <a href={documentary.url} target="_blank" rel="noopener noreferrer"
           class="group relative block rounded-xl overflow-hidden bg-black aspect-[2/1]">
          <div class="absolute inset-x-0 top-[11%] bottom-[11%]">
            <img src={documentary.image} alt={documentary.title}
                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          </div>
          <div class="absolute inset-x-0 bottom-0 h-[45%] bg-gradient-to-t from-black/80 to-transparent pointer-events-none"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-12 h-12 rounded-full bg-white/15 backdrop-blur-sm border border-white/20 flex items-center justify-center group-hover:bg-white/30 group-hover:scale-105 transition-all duration-200">
              <svg class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-4">
            <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-white/40">{documentary.type} · {documentary.publication} · {documentary.year}</p>
            <h3 class="mt-1 text-sm font-semibold text-white leading-snug">{documentary.title}</h3>
          </div>
        </a>

      </div>
    </div>
  </section>

</BaseLayout>
